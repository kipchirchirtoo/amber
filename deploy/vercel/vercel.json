{
  "cleanUrls": true,
  "rewrites": [{ "source": "/(.*)", "destination": "/index.html" }],
  "headers": [
    { "source": "/(.*)", "headers": [{ "key": "Cache-Control", "value": "no-cache" }] },
    { "source": "/(.*)\.(js|wasm|otf|ttf|png|ico)", "headers": [{ "key": "Cache-Control", "value": "public, max-age=86400" }] }
  ]
}
