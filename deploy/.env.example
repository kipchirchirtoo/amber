# Copy this file to ".env" (same folder) and fill it in. Never share or commit .env.

# The web address people will use. Its DNS "A" record must already point at this server.
DOMAIN=quotes.example.co.ke

# Database password. Use ONLY letters and digits (it goes inside a web address).
DB_PASSWORD=change-this-to-a-long-random-string

# First administrator, as username:password. Used only while no user exists yet.
# Username: lower-case letters, digits, . _ -   Password: at least 8 characters.
BOOTSTRAP_ADMIN=boss:choose-a-strong-password

# AI assistant. Leave empty to keep it switched off (the rest of the app works without it).
ANTHROPIC_API_KEY=
AMBER_AI_MODEL=
# Optional extra / alternative AI services. Every key you set is used, in this order:
# Anthropic, OpenAI, Gemini, Groq. If one is down or out of quota the next one answers.
OPENAI_API_KEY=
AMBER_OPENAI_MODEL=
GEMINI_API_KEY=
AMBER_GEMINI_MODEL=
GROQ_API_KEY=
AMBER_GROQ_MODEL=
# AMBER_AI_PROVIDER=gemini   (anthropic, openai, gemini or groq: use only that one)
